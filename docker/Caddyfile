# The only door into the container: a password on every request, then ComfyUI on localhost.
# Put HTTPS in front of it (RunPod's proxy does: https://<pod id>-8188.proxy.runpod.net).
{
	admin off
	auto_https off
	persist_config off
}

:8188 {
	# route: in this order, so the password comes first (Caddy would otherwise redirect before it)
	route {
		basic_auth {
			{$ZT_USER} {$ZT_PASSWORD_HASH}
		}
		redir / /zentrainer/
		# ComfyUI refuses every cross-site request, which includes opening the app from another site
		# (RunPod's Connect button). Loading a page is safe to let through; any other request keeps
		# the header, so ComfyUI still turns away other sites using the browser's saved password.
		@pageload {
			method GET
			header Sec-Fetch-Mode navigate
		}
		request_header @pageload -Sec-Fetch-Site
		reverse_proxy 127.0.0.1:8189
	}
}
