#!/usr/bin/env python3
"""zt — set up and run ZenTrainer's own ComfyUI, or attach to an existing one.

    zt setup [--models-from DIR]... [--extra-model-paths YAML]... [--torch VARIANT] [--zenkit DIR]
    zt start [--port N] [--open] [-- extra ComfyUI args]
    zt dev [--port N]          ComfyUI in the background + the web app with hot reload
    zt restart [--force]       restart the running managed ComfyUI
    zt extras optimizers       Prodigy, 8-bit AdamW/Lion, schedule-free, CAME
    zt update [--ref REF]
    zt attach COMFYUI_DIR
    zt doctor

Headless (scriptable; starts ComfyUI in the background when it isn't running):
    zt train SPEC.json [--profile ID] [--set key=value]... [--end] [--follow]
    zt runs [--json]           zt follow RUN       zt spec RUN > spec.json
    zt pause|unpause|stop|save RUN                 zt resume RUN [--set key=value]...
    zt sample RUN "prompt" [--base] [--size WxH] [--seed N]
    zt queue [pause|resume]    zt caption DATASET --model FILE [--style nl|tags] [--all]

The managed ComfyUI lives in ./comfyui (pinned by comfy.lock, own .venv) and uses its
own input/, output/ and user/ folders, as any ComfyUI does. All gitignored. Models are never copied:
--models-from points the instance at existing ComfyUI installs or model folders.
Standard library only, so it runs before anything is installed.
"""

from __future__ import annotations

import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import webbrowser
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
COMFY = ROOT / "comfyui"
LOCK = ROOT / "comfy.lock"
LOCAL = ROOT / ".zentrainer" / "local.json"  # machine-specific, gitignored
ENGINE = ROOT / "engine"
WINDOWS = platform.system() == "Windows"

# folders an existing ComfyUI keeps under models/
MODEL_FOLDERS = ["checkpoints", "diffusion_models", "unet", "loras", "vae", "text_encoders", "clip",
                 "clip_vision", "controlnet", "embeddings", "upscale_models", "model_patches"]


# ---- helpers -------------------------------------------------------------------

def say(msg: str) -> None:
    print(f"\033[35m›\033[0m {msg}", flush=True)


def die(msg: str) -> None:
    print(f"\033[31m✗\033[0m {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd: list, **kw) -> None:
    say(" ".join(str(c) for c in cmd))
    subprocess.run([str(c) for c in cmd], check=True, **kw)


def lock() -> dict:
    return json.loads(LOCK.read_text())


def local() -> dict:
    return json.loads(LOCAL.read_text()) if LOCAL.is_file() else {}


def save_local(cfg: dict) -> None:
    LOCAL.parent.mkdir(exist_ok=True)
    LOCAL.write_text(json.dumps(cfg, indent=2) + "\n")


def venv_python() -> Path:
    return COMFY / ".venv" / ("Scripts/python.exe" if WINDOWS else "bin/python")


def need(tool: str, hint: str) -> None:
    if not shutil.which(tool):
        die(f"{tool} not found. {hint}")


def link(target: Path, at: Path) -> None:
    """Symlink `at` -> `target`; replaces a stale link, refuses to clobber a real folder."""
    if at.is_symlink():
        at.unlink()
    elif at.exists():
        die(f"{at} exists and is not a link; remove it or pick another name")
    at.parent.mkdir(parents=True, exist_ok=True)
    try:
        at.symlink_to(target, target_is_directory=True)
    except OSError as e:
        if WINDOWS:  # symlinks need developer mode; a junction doesn't
            run(["cmd", "/c", "mklink", "/J", str(at), str(target)])
        else:
            die(f"could not link {at} -> {target}: {e}")
    say(f"linked {at.relative_to(ROOT) if at.is_relative_to(ROOT) else at} -> {target}")


def driver_cuda() -> tuple[int, int] | None:
    if not shutil.which("nvidia-smi"):
        return None
    out = subprocess.run(["nvidia-smi"], capture_output=True, text=True).stdout
    m = re.search(r"CUDA (?:UMD )?Version:\s*(\d+)\.(\d+)", out)  # newer drivers say "CUDA UMD Version"
    return (int(m[1]), int(m[2])) if m else None


def pick_torch(variants: dict) -> str:
    cuda = driver_cuda()
    if cuda:
        for name, req in variants.items():
            if name.startswith("cu") and "min_driver_cuda" in req:
                major, minor = (int(x) for x in req["min_driver_cuda"].split("."))
                if cuda >= (major, minor):
                    return name
        die(f"NVIDIA driver reports CUDA {cuda[0]}.{cuda[1]}, older than any pinned torch build; update the driver")
    if shutil.which("rocminfo") and any(v.startswith("rocm") for v in variants):
        return next(v for v in variants if v.startswith("rocm"))
    return "cpu"


def models_yaml(sources: list[Path]) -> Path | None:
    """extra_model_paths.yaml covering each source's model folders: an install's models/,
    or a plain folder of checkpoints/, loras/, ... A ComfyUI install's own yaml is passed
    to ComfyUI separately (see comfy_model_configs)."""
    lines = ["# written by zt setup; regenerate with `zt setup --models-from ...`"]
    for i, d in enumerate(sources):
        base = d / "models" if (d / "models").is_dir() else d
        found = [f for f in MODEL_FOLDERS if (base / f).is_dir()]
        if not found:
            continue
        lines.append(f"zentrainer_{i}:")
        lines.append(f"  base_path: {json.dumps(str(base))}")
        lines += [f"  {f}: {f}/" for f in found]
    if len(lines) == 1:
        return None
    path = ROOT / ".zentrainer" / "extra_model_paths.yaml"
    path.parent.mkdir(exist_ok=True)
    path.write_text("\n".join(lines) + "\n")
    return path


def comfy_model_configs(sources: list[Path]) -> list[str]:
    """Each existing ComfyUI install's own extra_model_paths.yaml, used as-is."""
    out = []
    for s in sources:
        if not (s / "main.py").is_file():
            continue
        yaml = s / "extra_model_paths.yaml"
        if yaml.is_file():
            out.append(str(yaml))
    return out


# ---- commands ------------------------------------------------------------------

def cmd_setup(a) -> None:
    need("git", "Install git.")
    need("uv", "Install uv: https://docs.astral.sh/uv/getting-started/installation/")
    L = lock()
    ref = L["comfyui"]["ref"]

    # 1. ComfyUI at the pinned commit
    if not (COMFY / ".git").is_dir():
        run(["git", "clone", "--filter=blob:none", L["comfyui"]["repo"], COMFY])
    else:
        run(["git", "-C", COMFY, "fetch", "--quiet", "origin"])
    dirty = subprocess.run(["git", "-C", COMFY, "status", "--porcelain", "--untracked-files=no"],
                           capture_output=True, text=True).stdout.strip()
    if dirty:
        die(f"{COMFY} has local changes; commit or discard them before re-pinning")
    run(["git", "-C", COMFY, "checkout", "--quiet", ref])

    # 2. its own environment
    variant = a.torch or pick_torch(L["torch"]["variants"])
    if not venv_python().is_file():
        run(["uv", "venv", "--python", L["python"], COMFY / ".venv"])
    tv = L["torch"]["version"]
    run(["uv", "pip", "install", "--python", venv_python(), f"torch=={tv}", "torchvision", "torchaudio",
         "--index-url", f"https://download.pytorch.org/whl/{variant}"])
    run(["uv", "pip", "install", "--python", venv_python(), "-r", COMFY / "requirements.txt"])

    # 3. the engine, and optionally ZenKit
    link(ENGINE, COMFY / "custom_nodes" / "zentrainer")
    if a.zenkit:
        link(Path(a.zenkit).expanduser().resolve(), COMFY / "custom_nodes" / "ComfyUI-ZenKit")

    # 4. where models come from (never copied)
    cfg = local()
    if a.models_from or a.extra_model_paths:
        sources = [Path(p).expanduser().resolve() for p in a.models_from or []]
        for s in sources:
            if not s.is_dir():
                die(f"--models-from {s}: not a directory (for a yaml file use --extra-model-paths)")
        yamls = [Path(p).expanduser().resolve() for p in a.extra_model_paths or []]
        for y in yamls:
            if not y.is_file():
                die(f"--extra-model-paths {y}: no such file")
        gen = models_yaml(sources)
        cfg["extra_model_paths"] = [str(y) for y in yamls] + comfy_model_configs(sources) + ([str(gen)] if gen else [])
    cfg.update(torch=variant, ref=ref)
    save_local(cfg)

    # 5. the web app, when the toolchain is there
    if (ROOT / "web" / "dist" / "index.html").is_file() and not a.build_web:
        say("web/dist exists; pass --build-web to rebuild")
    elif shutil.which("pnpm"):
        run(["pnpm", "install"], cwd=ROOT / "web")
        run(["pnpm", "build"], cwd=ROOT / "web")
    else:
        say("pnpm not found: skipping the web build (the API still works; install pnpm and run `pnpm build` in web/)")

    say(f"ready: ComfyUI {L['comfyui']['describe']}, torch {tv}+{variant}. Start it with `scripts/zt start`.")
    if not cfg.get("extra_model_paths"):
        say("no model sources configured: add your existing ones with `scripts/zt setup --models-from /path/to/ComfyUI`")


def comfy_args(port: int) -> list[str]:
    cfg = local()
    args = ["--port", str(port)]  # ComfyUI's own input/, output/, user/ folders
    for y in cfg.get("extra_model_paths", []):
        args += ["--extra-model-paths-config", y]
    return args


def cmd_start(a) -> None:
    if not venv_python().is_file():
        die("no managed ComfyUI yet: run `scripts/zt setup` first")
    port = _port(a)
    url = f"http://127.0.0.1:{port}/zentrainer/"
    say(f"ZenTrainer at {url}")
    if a.open:
        webbrowser.open(url)
    os.chdir(COMFY)
    cmd = [str(venv_python()), "main.py", *comfy_args(port), *a.rest]
    if WINDOWS:
        sys.exit(subprocess.call(cmd))
    os.execv(cmd[0], cmd)


def _port(a) -> int:
    return a.port or local().get("port") or lock()["port"]


def _alive(port: int) -> bool:
    import urllib.request

    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/zentrainer/api/health", timeout=1):
            return True
    except Exception:
        return False


def cmd_dev(a) -> None:
    """ComfyUI (reused if already up) plus Vite's dev server. Edits to web/ show up
    instantly; engine (Python) edits need `zt restart`."""
    import time

    need("pnpm", "Install pnpm: https://pnpm.io/installation")
    port = _port(a)
    comfy = None
    if _alive(port):
        say(f"using the ComfyUI already running on :{port}")
    else:
        if not venv_python().is_file():
            die("no managed ComfyUI yet: run `scripts/zt setup` first")
        log = ROOT / ".zentrainer" / "comfy.log"
        log.parent.mkdir(exist_ok=True)
        say(f"starting ComfyUI on :{port} (log: {log.relative_to(ROOT)})")
        comfy = subprocess.Popen([str(venv_python()), "main.py", *comfy_args(port)], cwd=COMFY,
                                 stdout=open(log, "ab"), stderr=subprocess.STDOUT)
        for _ in range(240):
            if _alive(port):
                break
            if comfy.poll() is not None:
                die(f"ComfyUI exited ({comfy.returncode}); see {log}")
            time.sleep(0.5)
        else:
            die(f"ComfyUI didn't come up; see {log}")
    if not (ROOT / "web" / "node_modules").is_dir():
        run(["pnpm", "install"], cwd=ROOT / "web")
    say("app with hot reload: http://localhost:5173/zentrainer/")
    env = {**os.environ, "COMFY_URL": f"http://127.0.0.1:{port}"}
    try:
        subprocess.call(["pnpm", "dev"], cwd=ROOT / "web", env=env)
    except KeyboardInterrupt:
        pass
    finally:
        if comfy and comfy.poll() is None:
            say("stopping ComfyUI")
            comfy.terminate()
            try:
                comfy.wait(15)
            except subprocess.TimeoutExpired:
                comfy.kill()


def cmd_restart(a) -> None:
    import time
    import urllib.error
    import urllib.request

    port = _port(a)
    if not _alive(port):
        die(f"nothing answering on :{port}; start it with `scripts/zt start` or `scripts/zt dev`")
    req = urllib.request.Request(f"http://127.0.0.1:{port}/zentrainer/api/restart", method="POST",
                                 data=json.dumps({"force": a.force}).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=5)
    except urllib.error.HTTPError as e:
        die(json.loads(e.read() or b"{}").get("error", str(e)))
    say("restarting…")
    time.sleep(2)
    for _ in range(240):
        if _alive(port):
            say(f"back up on :{port}")
            return
        time.sleep(0.5)
    die("ComfyUI didn't come back; check its console")


EXTRAS = {
    "optimizers": ["prodigyopt", "bitsandbytes", "schedulefree", "came-pytorch"],
}


def cmd_extras(a) -> None:
    if not venv_python().is_file():
        die("no managed ComfyUI yet: run `scripts/zt setup` first")
    pkgs = [p for g in a.groups for p in EXTRAS[g]]
    run(["uv", "pip", "install", "--python", venv_python(), *pkgs])
    say("installed; restart ComfyUI (`scripts/zt restart`) to use them")


def cmd_update(a) -> None:
    L = lock()
    if a.ref:
        L["comfyui"]["ref"] = a.ref
        if (COMFY / ".git").is_dir():
            run(["git", "-C", COMFY, "fetch", "--quiet", "--tags", "origin"])
            sha = subprocess.run(["git", "-C", COMFY, "rev-parse", a.ref + "^{commit}"],
                                 capture_output=True, text=True, check=True).stdout.strip()
            desc = subprocess.run(["git", "-C", COMFY, "describe", "--tags", sha],
                                  capture_output=True, text=True).stdout.strip()
            L["comfyui"].update(ref=sha, describe=desc or sha[:9])
        LOCK.write_text(json.dumps(L, indent=2) + "\n")
        say(f"comfy.lock -> {L['comfyui']['ref']} ({L['comfyui']['describe']}). Test before committing the lock.")
    ns = argparse.Namespace(models_from=None, extra_model_paths=None, torch=local().get("torch"), zenkit=None, build_web=False)
    cmd_setup(ns)


def cmd_attach(a) -> None:
    target = Path(a.comfyui).expanduser().resolve()
    if not (target / "main.py").is_file():
        die(f"{target} doesn't look like a ComfyUI checkout (no main.py)")
    link(ENGINE, target / "custom_nodes" / "zentrainer")
    ver = target / "comfyui_version.py"
    m = re.search(r'"([^"]+)"', ver.read_text()) if ver.is_file() else None
    say(f"attached to ComfyUI {m[1] if m else '(unknown version)'}; tested pin is {lock()['comfyui']['describe']}")
    say("restart that ComfyUI, then open /zentrainer/ on its port")


def cmd_doctor(_a) -> None:
    L, cfg = lock(), local()
    print(f"pin        {L['comfyui']['describe']}  ({L['comfyui']['ref'][:12]})")
    if (COMFY / ".git").is_dir():
        head = subprocess.run(["git", "-C", COMFY, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
        print(f"checkout   {head[:12]}  {'ok' if head == L['comfyui']['ref'] else 'DIFFERS from pin: run zt setup'}")
    else:
        print("checkout   missing: run zt setup")
    link_ = COMFY / "custom_nodes" / "zentrainer"
    print(f"engine     {'linked' if link_.is_symlink() else 'not linked'}")
    own = COMFY / "extra_model_paths.yaml"  # ComfyUI always loads this one itself
    sources = ([f"{own} (auto)"] if own.is_file() else []) + cfg.get("extra_model_paths", [])
    print(f"models     {', '.join(sources) or 'none: put an extra_model_paths.yaml in comfyui/, or zt setup --models-from ...'}")
    print(f"web        {'built' if (ROOT / 'web/dist/index.html').is_file() else 'not built'}")
    cuda = driver_cuda()
    print(f"driver     {'CUDA %d.%d' % cuda if cuda else 'no NVIDIA driver found'}")
    if venv_python().is_file():
        code = ("import torch;print(torch.__version__, 'cuda' if torch.cuda.is_available() else 'no-cuda',"
                " torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')")
        out = subprocess.run([str(venv_python()), "-c", code], capture_output=True, text=True)
        print(f"torch      {out.stdout.strip() or out.stderr.strip().splitlines()[-1]}")
    else:
        print("torch      no venv")

# ---- headless: drive the engine over its HTTP API ---------------------------------
# Everything the app does goes through /zentrainer/api, so these are thin: a spec file in,
# a run id out, and `follow` to block until it ends (exit 0 done, 1 failed/stopped).

TERMINAL = ("done", "error", "stopped", "interrupted", "rejected")


def _api(a, method: str, path: str, body=None):
    import urllib.error
    import urllib.request

    url = f"http://127.0.0.1:{_port(a)}/zentrainer/api{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.load(e).get("error") or e.reason
        except Exception:
            msg = e.reason
        die(f"{method} {path}: {msg}")
    except urllib.error.URLError:
        die(f"no ZenTrainer on :{_port(a)} (scripts/zt start)")


def _ensure_server(a) -> None:
    """Start the managed ComfyUI in the background if nothing answers; it keeps running."""
    import time

    port = _port(a)
    if _alive(port):
        return
    if not venv_python().is_file():
        die("no managed ComfyUI yet: run `scripts/zt setup` first")
    log = ROOT / ".zentrainer" / "comfy.log"
    log.parent.mkdir(exist_ok=True)
    say(f"starting ComfyUI on :{port} in the background (log: {log.relative_to(ROOT)})")
    subprocess.Popen([str(venv_python()), "main.py", *comfy_args(port)], cwd=COMFY, stdout=open(log, "ab"),
                     stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(480):
        if _alive(port):
            return
        time.sleep(0.5)
    die(f"ComfyUI didn't come up; see {log}")


def _value(v: str):
    try:
        return json.loads(v)
    except ValueError:
        return v  # a bare string


def _apply_sets(spec: dict, sets: list[str] | None) -> dict:
    """--set optim.learning_rate=1e-4 --set samples.prompts='["a cat"]': dotted keys, JSON values."""
    for item in sets or []:
        key, eq, val = item.partition("=")
        if not eq:
            die(f"--set wants key=value, got {item!r}")
        node = spec
        *parents, leaf = key.split(".")
        for k in parents:
            node = node.setdefault(k, {})
        node[leaf] = _value(val)
    return spec


def _deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in over.items():
        out[k] = _deep_merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def cmd_train(a) -> None:
    spec = json.loads(Path(a.spec).read_text()) if a.spec != "-" else json.load(sys.stdin)
    if a.profile:
        prof = ENGINE / "profiles" / f"{a.profile}.json"
        if not prof.is_file():
            die(f"no profile {a.profile!r}; have {', '.join(p.stem for p in (ENGINE / 'profiles').glob('*.json'))}")
        spec = _deep_merge(json.loads(prof.read_text()).get("train", {}), spec)  # the file wins over the profile
    spec = _apply_sets(spec, a.set)
    _ensure_server(a)
    run = _api(a, "POST", "/runs", {"spec": spec, "position": "end" if a.end else "next"})["run"]
    print(run["run_id"])
    if a.follow:
        _follow(a, run["run_id"])


def cmd_runs(a) -> None:
    runs = _api(a, "GET", "/runs")["runs"]
    if a.json:
        print(json.dumps(runs, indent=2))
        return
    for r in runs:
        print(f"{r['run_id']}  {r.get('status', '?'):<11} {r.get('final_step') or '':>6}  {r.get('name', '')}")


def _follow(a, run_id: str) -> None:
    """Print progress until the run ends; exit status says how it ended."""
    import time

    seen, last_status, last_samples = None, None, None
    while True:
        d = _api(a, "GET", f"/runs/{run_id}")
        status = d["run"].get("status")
        if status != last_status:
            msg = d["run"].get("message")
            say(f"{status}" + (f": {msg}" if msg else ""))
            last_status = status
        total = (d.get("spec") or {}).get("optim", {}).get("steps")
        rows = d.get("metrics") or []
        if seen is None:
            seen = max(0, len(rows) - 1)  # joining a run partway: start at its latest step
        for m in rows[seen:]:
            if m.get("step", 0) % a.every == 0 or m is rows[-1]:
                ph = m.get("phases") or {}
                extra = " ".join(f"{k} {v:.2f}s" for k, v in ph.items()) if a.phases else ""
                rate = m.get("rate") or m.get("it_s") or 0
                print(f"step {m.get('step')}/{total}  loss {m.get('loss') or 0:.4f}  lr {m.get('lr') or 0:.2e}"
                      + (f"  {1 / rate:.2f}s/step" if rate else "") + (f"  {extra}" if extra else ""), flush=True)
        seen = len(rows)
        n = len(d.get("samples") or [])
        if last_samples is not None and n > last_samples:
            print(f"  {n - last_samples} new sample(s)", flush=True)
        last_samples = n
        if status in TERMINAL:
            ck = d.get("checkpoints") or []
            if ck:
                print(ck[-1]["path"])
            sys.exit(0 if status == "done" else 1)
        time.sleep(a.interval)


def cmd_follow(a) -> None:
    _follow(a, a.run)


def cmd_spec(a) -> None:
    print(json.dumps(_api(a, "GET", f"/runs/{a.run}")["spec"], indent=2))


def cmd_control(a) -> None:
    command = {"unpause": "resume"}.get(a.cmd, a.cmd)
    _api(a, "POST", f"/runs/{a.run}/control", {"command": command})
    say(f"{a.cmd}: {a.run}")


def cmd_resume(a) -> None:
    _ensure_server(a)
    d = _api(a, "GET", f"/runs/{a.run}")
    if a.set:  # settings that may change before it continues (memory, samples, LR, length...)
        _api(a, "PUT", f"/runs/{a.run}/spec", {"spec": _apply_sets(d["spec"], a.set)})
    if d["run"].get("status") == "queued":  # waiting its turn already: the edit is all it needs
        say(f"{a.run} is queued; settings updated")
    else:
        _api(a, "POST", f"/runs/{a.run}/resume", {})
        say(f"resumed {a.run}")
    if a.follow:
        _follow(a, a.run)


def cmd_sample(a) -> None:
    args = {"prompt": a.prompt, "base": a.base}
    if a.size:
        w, _, h = a.size.lower().partition("x")
        args.update(width=int(w), height=int(h))
    if a.seed is not None:
        args["seed"] = a.seed
    _api(a, "POST", f"/runs/{a.run}/control", {"command": "sample", "args": args})
    say("queued; it renders at the next step boundary")


def cmd_queue(a) -> None:
    if a.action:
        _api(a, "POST", "/queue", {"action": a.action})
    q = _api(a, "GET", "/queue")
    print(f"{'paused' if q['paused'] else 'running'}" + (f", training {q['current']['run_id']}" if q.get("current") else ""))
    for r in q["items"]:
        print(f"  {r['run_id']}  {r.get('name', '')}")


def cmd_caption(a) -> None:
    _ensure_server(a)
    body = {"clip_name": a.model, "style": a.style, "mode": "all" if a.all else "missing",
            "set": a.set_name, "replace_default": a.all}
    job = _api(a, "POST", f"/datasets/{a.dataset}/caption", body)["job"]
    print(job["job_id"])
    if a.follow:
        import time

        while True:
            j = _api(a, "GET", f"/caption/{job['job_id']}")
            j = j.get("job", j)
            print(f"\r{j.get('status')}  {j.get('done', 0)}/{j.get('total', '?')}  {j.get('message') or ''}"[:120],
                  end="", flush=True)
            if j.get("status") in ("done", "error", "cancelled", "stopped"):
                print()
                sys.exit(0 if j.get("status") == "done" else 1)
            time.sleep(2)


def _client(sub, name: str, fn, help: str):
    s = sub.add_parser(name, help=help)
    s.add_argument("--port", type=int)
    s.set_defaults(fn=fn)
    return s


def main() -> None:
    ap = argparse.ArgumentParser(prog="zt", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("setup", help="clone the pinned ComfyUI, install it, link the engine")
    s.add_argument("--models-from", action="append", metavar="DIR",
                   help="an existing ComfyUI install or models folder to use in place (repeatable)")
    s.add_argument("--extra-model-paths", action="append", metavar="YAML",
                   help="a ComfyUI extra_model_paths.yaml to use as-is (repeatable)")
    s.add_argument("--torch", help="torch build: cu130, cu128, cu126, rocm6.4, cpu (default: detect)")
    s.add_argument("--zenkit", metavar="DIR", help="link a ComfyUI-ZenKit checkout for its themes")
    s.add_argument("--build-web", action="store_true", help="rebuild web/dist even if it exists")
    s.set_defaults(fn=cmd_setup)

    s = sub.add_parser("start", help="run the managed ComfyUI with ZenTrainer")
    s.add_argument("--port", type=int)
    s.add_argument("--open", action="store_true", help="open the app in a browser")
    s.add_argument("rest", nargs=argparse.REMAINDER, help="after --: extra ComfyUI arguments")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("dev", help="ComfyUI in the background + the web app with hot reload")
    s.add_argument("--port", type=int)
    s.set_defaults(fn=cmd_dev)

    s = sub.add_parser("restart", help="restart the running managed ComfyUI (picks up engine changes)")
    s.add_argument("--port", type=int)
    s.add_argument("--force", action="store_true", help="even if a run is training")
    s.set_defaults(fn=cmd_restart)

    s = sub.add_parser("extras", help="install optional packages into the managed ComfyUI")
    s.add_argument("groups", nargs="+", choices=["optimizers"], help="optimizers: Prodigy, 8-bit, schedule-free, CAME")
    s.set_defaults(fn=cmd_extras)

    s = sub.add_parser("update", help="re-sync to comfy.lock, or move the pin with --ref")
    s.add_argument("--ref", help="a ComfyUI commit, tag or branch to pin")
    s.set_defaults(fn=cmd_update)

    s = sub.add_parser("attach", help="link the engine into an existing ComfyUI instead")
    s.add_argument("comfyui")
    s.set_defaults(fn=cmd_attach)

    sub.add_parser("doctor", help="show what's installed and where models come from").set_defaults(fn=cmd_doctor)

    s = _client(sub, "train", cmd_train, "queue a training run from a spec file (- for stdin); prints its id")
    s.add_argument("spec")
    s.add_argument("--profile", help="start from an engine profile's settings (e.g. minimax-h3)")
    s.add_argument("--set", action="append", metavar="KEY=VALUE", help="override a setting (dotted key, JSON value)")
    s.add_argument("--end", action="store_true", help="join the end of the queue instead of starting next")
    s.add_argument("--follow", action="store_true", help="print progress until it ends")
    for name, fn, h in [("runs", cmd_runs, "list runs"), ("spec", cmd_spec, "print a run's settings as JSON")]:
        s = _client(sub, name, fn, h)
        if name == "runs":
            s.add_argument("--json", action="store_true")
        else:
            s.add_argument("run")
    s = _client(sub, "follow", cmd_follow, "print a run's progress until it ends (exit 0 = done)")
    s.add_argument("run")
    for name in ("pause", "unpause", "stop", "save"):
        _client(sub, name, cmd_control, f"{name} a training run").add_argument("run")
    s = _client(sub, "resume", cmd_resume, "continue a stopped run from its latest checkpoint")
    s.add_argument("run")
    s.add_argument("--set", action="append", metavar="KEY=VALUE", help="change a setting first (not model/dataset/network)")
    s.add_argument("--follow", action="store_true")
    s = _client(sub, "sample", cmd_sample, "render a prompt with the current LoRA mid-run")
    s.add_argument("run")
    s.add_argument("prompt")
    s.add_argument("--base", action="store_true", help="without the LoRA, to compare")
    s.add_argument("--size", metavar="WxH")
    s.add_argument("--seed", type=int)
    s = _client(sub, "queue", cmd_queue, "show the queue, or pause/resume it")
    s.add_argument("action", nargs="?", choices=["pause", "resume"])
    s = _client(sub, "caption", cmd_caption, "auto-caption a dataset")
    s.add_argument("dataset")
    s.add_argument("--model", required=True, help="a vision text encoder file (as listed in the app)")
    s.add_argument("--style", default="nl")
    s.add_argument("--set", dest="set_name", default="default", help="caption set")
    s.add_argument("--all", action="store_true", help="rewrite existing captions too")
    s.add_argument("--follow", action="store_true")
    for name in ("train", "follow", "resume"):
        sub.choices[name].add_argument("--every", type=int, default=10, help="print every Nth step")
        sub.choices[name].add_argument("--interval", type=float, default=5.0, help="seconds between checks")
        sub.choices[name].add_argument("--phases", action="store_true", help="show the step's timing breakdown")

    a = ap.parse_args()
    if getattr(a, "rest", None) and a.rest[0] == "--":
        a.rest = a.rest[1:]
    try:
        a.fn(a)
    except subprocess.CalledProcessError as e:
        die(f"command failed ({e.returncode}): {' '.join(map(str, e.cmd))}")


if __name__ == "__main__":
    main()
