#!/usr/bin/env python3
"""zt now lives in cli/ (a small package: rich, questionary, textual). This runs it through uv,
so `scripts/zt …` keeps working; `uv tool install --editable ./cli` puts `zt` on your PATH instead."""

import os
import shutil
import subprocess
import sys
from pathlib import Path

cli = Path(__file__).resolve().parent.parent / "cli"
uv = shutil.which("uv") or shutil.which("uv", path=str(Path.home() / ".local" / "bin"))
if not uv:
    sys.exit("zt needs uv: run start-linux.sh or start-windows.bat (they install it), or see https://docs.astral.sh/uv/")
cmd = [uv, "run", "--quiet", "--frozen", "--project", str(cli), "zt", *sys.argv[1:]]
if os.name == "nt":
    sys.exit(subprocess.call(cmd))
os.execv(uv, cmd)
